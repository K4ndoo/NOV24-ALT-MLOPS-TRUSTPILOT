FROM python:3.12-slim

# on empêche Python de générer des fichiers .pyc et on force l'affichage des logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# on copie uniquement les requirements d'abord (pour optimiser le cache Docker)
COPY requirements.txt .

# on installe PyTorch en premier (Version CPU pour éviter que requirements.txt ne télécharge la version GPU énorme de ~5GB)
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# on installe les autres librairies
RUN pip install --no-cache-dir -r requirements.txt

# On copie tout
COPY . .

# on expose le port 8000 pour FastAPI
EXPOSE 8000

# Commande de lancement de l'API
CMD ["uvicorn", "src.api.main:api", "--host", "0.0.0.0", "--port", "8000"]
