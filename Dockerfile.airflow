FROM apache/airflow:2.9.2

USER root

# installation des dépendances système 
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
         build-essential \
  && apt-get autoremove -yqq --purge \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

USER airflow

# Copie des requirements
COPY requirements.txt /tmp/requirements.txt

# Installation des librairies Python (on installe la version CPU de PyTorch en premier pour éviter que requirements.txt ne télécharge la version GPU énorme de ~5GB)
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements.txt

USER root
# Installation des dépendances système Chromium via le binaire playwright de l'utilisateur airflow
RUN PATH="/home/airflow/.local/bin:$PATH" playwright install-deps chromium

USER airflow
# Installation des navigateurs
RUN playwright install chromium
